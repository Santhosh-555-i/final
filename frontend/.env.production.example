# EventLens AI Frontend — Production Environment Variables
# Copy these values into your Vercel Project Settings -> Environment Variables

# Backend API server URL (e.g. your Render / Railway service URL)
# Next.js server will proxy /api/* and /static/* to this URL seamlessly
BACKEND_INTERNAL_URL=https://eventlens-backend.onrender.com

# Public Backend URL for browser direct fallback
NEXT_PUBLIC_BACKEND_URL=https://eventlens-backend.onrender.com
NEXT_PUBLIC_API_URL=/api
