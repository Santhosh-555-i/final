# EventLens AI Frontend — Production Environment Variables
# Copy these values into your Vercel Project Settings -> Environment Variables

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Server-side proxy target: Next.js rewrites /api/* and /static/* to this URL.
# This is a server-only variable (no NEXT_PUBLIC_ prefix) — never sent to browser.
# Set this in Vercel > Project Settings > Environment Variables > Production.
BACKEND_INTERNAL_URL=https://eventlens-backend-25hc.onrender.com

# ── RECOMMENDED ───────────────────────────────────────────────────────────────
# Fallback used by next.config.ts if BACKEND_INTERNAL_URL is not set,
# and by the browser for resolving relative /static/... image URLs.
NEXT_PUBLIC_BACKEND_URL=https://eventlens-backend-25hc.onrender.com

# API path prefix used by the browser-side API client.
# Keep as /api in production so all requests go through Next.js proxy rewrites.
NEXT_PUBLIC_API_URL=/api
